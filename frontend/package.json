{
  "name": "vidlens-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:stream": "node scripts/test-stream-proxy.mjs",
    "test:ui": "vitest run components/shell/useLeaveGuard.test.tsx components/settings/CapabilityProbe.test.tsx components/settings/PromptPreferencesSection.test.tsx components/chat/MarkdownAnswer.test.tsx components/chat/ChatWorkspace.test.tsx components/artifacts/ArtifactWorkspace.test.tsx components/artifacts/ArtifactAgentPanel.test.tsx",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --no-warnings --experimental-strip-types --test \"lib/**/*.test.ts\" \"components/chat/**/*.test.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^0.408.0",
    "markmap-view": "^0.18.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
