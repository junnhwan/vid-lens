# Copy this file to .env. The real .env is ignored by Git.
# Process environment variables take precedence over values in .env.

# Active server-side AI protocol label. Every label uses the standard
# OpenAI-compatible wire protocol; the label is kept for observability only.
VIDLENS_AI_PROVIDER=openai_compatible
VIDLENS_AI_BASE_URL=
VIDLENS_AI_API_KEY=

# Capability-specific settings. Base URL means the /v1 root for Chat, ASR,
# and Vision. Embedding/Rerank use their complete endpoint paths.
VIDLENS_LLM_BASE_URL=https://chat-relay.example.com/v1
VIDLENS_LLM_API_KEY=sk-your-chat-key
VIDLENS_LLM_MODEL=deepseek-ai/DeepSeek-V3
# VIDLENS_LLM_PROVIDER=openai_compatible

VIDLENS_ASR_BASE_URL=https://asr-relay.example.com/v1
VIDLENS_ASR_API_KEY=sk-your-asr-key
VIDLENS_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# VIDLENS_ASR_PROVIDER=openai_compatible

VIDLENS_EMBEDDING_ENDPOINT=https://embedding-relay.example.com/v1/embeddings
VIDLENS_EMBEDDING_API_KEY=sk-your-embedding-key
VIDLENS_EMBEDDING_MODEL=BAAI/bge-m3
VIDLENS_EMBEDDING_DIM=1024
# Must match the vector store dimension used by the active embedding model.
VIDLENS_RAG_EMBEDDING_DIM=1024

VIDLENS_RERANK_ENDPOINT=https://rerank-relay.example.com/v1/rerank
VIDLENS_RERANK_API_KEY=sk-your-rerank-key
VIDLENS_RERANK_MODEL=Qwen/Qwen3-Reranker-4B

VIDLENS_VISION_BASE_URL=https://vision-relay.example.com/v1
VIDLENS_VISION_API_KEY=sk-your-vision-key
VIDLENS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Secret used to encrypt users' saved AI profile API keys.
# Use a stable random value in local development; do not reuse a provider key.
VIDLENS_API_KEY_SECRET=change-me-to-a-random-secret

# Optional Docker data root. Leave unset to use ./data; make start auto-detects
# ../vid-lens-727/data when that historical data directory exists locally.
# VIDLENS_DATA_ROOT=./data

# Optional server bind address. Keep loopback for local development.
# VIDLENS_SERVER_HOST=127.0.0.1

# Optional local media tools. Defaults use binaries available on PATH.
# VIDLENS_FFMPEG_PATH=ffmpeg
# VIDLENS_YTDLP_PATH=yt-dlp
# VIDLENS_COOKIES_PATH=

# Optional AI quota failure policies.
VIDLENS_QUOTA_REDIS_DEFAULT_POLICY=fail_open
VIDLENS_QUOTA_REDIS_AI_POLICY=conservative_local
