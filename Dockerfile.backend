FROM --platform=$BUILDPLATFORM golang:1.26.5-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN GOMAXPROCS=2 CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -p 2 -trimpath -o /vidlens ./cmd/vidlens

FROM denoland/deno:2.9.6 AS javascript

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir 'yt-dlp[default]==2026.10.21'
COPY --from=javascript /usr/bin/deno /usr/local/bin/deno
COPY --from=build /vidlens /usr/local/bin/vidlens
COPY --chmod=755 scripts/backend_entrypoint.sh /usr/local/bin/vidlens-entrypoint
RUN useradd --system --uid 10001 --create-home vidlens && mkdir -p /var/lib/vidlens && chown vidlens:vidlens /var/lib/vidlens
ENV GOMEMLIMIT=768MiB GOGC=100 GOMAXPROCS=2
EXPOSE 8080
ENTRYPOINT ["vidlens-entrypoint"]
